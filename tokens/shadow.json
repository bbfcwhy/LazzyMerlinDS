{
  "$schema": "https://schemas.tokens-studio.com/latest/tokens-schema.json",
  "shadow": {
    "$description": "材質系統（§5）· 三層 register：Tactile / Hybrid / Soft Inset。完整 box-shadow 多層列表見 DESIGN.md §5.4。本檔僅列 token alias，完整 CSS 見 preview/components-preview.html。",
    "soft": {
      "$description": "Soft Neumorphic（§5.6）· 給 input / switch / slider 等控制元件的觸感層",
      "sm-light": {
        "$value": "6px 6px 12px rgba(33, 23, 21, 0.08), -6px -6px 12px rgba(255, 255, 255, 0.75)",
        "$type": "shadow"
      },
      "sm-dark": {
        "$value": "6px 6px 12px rgba(0, 0, 0, 0.45), -6px -6px 12px rgba(94, 122, 141, 0.06)",
        "$type": "shadow"
      },
      "md-light": {
        "$value": "10px 10px 20px rgba(33, 23, 21, 0.10), -10px -10px 20px rgba(255, 255, 255, 0.85)",
        "$type": "shadow"
      },
      "md-dark": {
        "$value": "10px 10px 20px rgba(0, 0, 0, 0.50), -10px -10px 20px rgba(94, 122, 141, 0.08)",
        "$type": "shadow"
      },
      "inset-light": {
        "$value": "inset 4px 4px 8px rgba(33, 23, 21, 0.08), inset -4px -4px 8px rgba(255, 255, 255, 0.75)",
        "$type": "shadow"
      },
      "inset-dark": {
        "$value": "inset 4px 4px 8px rgba(0, 0, 0, 0.35), inset -4px -4px 8px rgba(94, 122, 141, 0.06)",
        "$type": "shadow"
      }
    },
    "tactile-raised": {
      "$description": "Tactile Raised（§5.4.1）· 完整配方含對角光源 + 雙層 inset rim + 多層 drop shadow + noise overlay。本 token 僅 box-shadow 部分，gradient / noise / text-shadow 見 DESIGN.md §15.5.1。Button 跨 mode 同 box-shadow（v0.2.0 implementation-led 對齊 web preview 實作行為）；其他元件 light/dark 各自獨立。",
      "button-light": {
        "$value": "inset 0 2px 1px rgba(255, 255, 255, 0.35), inset 2px 0 1px rgba(255, 255, 255, 0.18), inset 0 -2px 1px rgba(0, 0, 0, 0.32), inset -2px 0 1px rgba(0, 0, 0, 0.20), inset 0 0 0 1px rgba(255, 255, 255, 0.10), 3px 4px 6px rgba(15, 28, 38, 0.18), 8px 12px 18px rgba(15, 28, 38, 0.22), 20px 28px 40px rgba(15, 28, 38, 0.20)",
        "$type": "shadow"
      },
      "button-dark": {
        "$value": "inset 0 2px 1px rgba(255, 255, 255, 0.35), inset 2px 0 1px rgba(255, 255, 255, 0.18), inset 0 -2px 1px rgba(0, 0, 0, 0.32), inset -2px 0 1px rgba(0, 0, 0, 0.20), inset 0 0 0 1px rgba(255, 255, 255, 0.10), 3px 4px 6px rgba(15, 28, 38, 0.18), 8px 12px 18px rgba(15, 28, 38, 0.22), 20px 28px 40px rgba(15, 28, 38, 0.20)",
        "$type": "shadow"
      },
      "card-light": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.5), inset 0 -1px 0 rgba(33, 23, 21, 0.10), inset 0 0 0 1px rgba(33, 23, 21, 0.05), 4px 6px 14px rgba(33, 23, 21, 0.12)",
        "$type": "shadow"
      },
      "card-dark": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 -1px 0 rgba(0, 0, 0, 0.35), inset 0 0 0 1px rgba(255, 255, 255, 0.03), 4px 6px 14px rgba(0, 0, 0, 0.45)",
        "$type": "shadow"
      },
      "chip-light": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 -1px 0 rgba(15, 28, 38, 0.18), inset 0 0 0 1px rgba(15, 28, 38, 0.06), 1px 2px 3px rgba(15, 28, 38, 0.14), 3px 5px 8px rgba(15, 28, 38, 0.14), 6px 10px 16px rgba(15, 28, 38, 0.10)",
        "$type": "shadow"
      },
      "chip-dark": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.10), inset 0 -1px 0 rgba(0, 0, 0, 0.40), inset 0 0 0 1px rgba(255, 255, 255, 0.04), 1px 2px 3px rgba(0, 0, 0, 0.40), 3px 5px 8px rgba(0, 0, 0, 0.45), 6px 10px 16px rgba(0, 0, 0, 0.30)",
        "$type": "shadow"
      },
      "avatar-light": {
        "$value": "inset 0 2px 1px rgba(255, 255, 255, 0.32), inset 0 -2px 1px rgba(0, 0, 0, 0.30), inset 0 0 0 1px rgba(0, 0, 0, 0.10), 2px 3px 5px rgba(15, 28, 38, 0.20), 5px 7px 12px rgba(15, 28, 38, 0.20), 12px 16px 22px rgba(15, 28, 38, 0.14)",
        "$type": "shadow"
      },
      "avatar-dark": {
        "$value": "inset 0 2px 1px rgba(255, 255, 255, 0.18), inset 0 -2px 1px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(0, 0, 0, 0.20), 2px 3px 5px rgba(0, 0, 0, 0.50), 5px 7px 12px rgba(0, 0, 0, 0.55), 12px 16px 22px rgba(0, 0, 0, 0.40)",
        "$type": "shadow"
      },
      "badge-light": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.30), inset 0 -1px 0 rgba(0, 0, 0, 0.25), inset 0 0 0 1px rgba(0, 0, 0, 0.10), 1px 1px 2px rgba(15, 28, 38, 0.18), 2px 3px 5px rgba(15, 28, 38, 0.18)",
        "$type": "shadow"
      },
      "badge-dark": {
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.18), inset 0 -1px 0 rgba(0, 0, 0, 0.40), inset 0 0 0 1px rgba(0, 0, 0, 0.20), 1px 1px 2px rgba(0, 0, 0, 0.50), 2px 3px 5px rgba(0, 0, 0, 0.55)",
        "$type": "shadow"
      }
    },
    "noise-overlay": {
      "$description": "Tactile noise overlay（§5.4 / §15.5.3）· 跨平台共用 PNG tile (assets/tactile-noise.png, 256×256, baseFrequency 1.6, stitchable)。Web 跟 iOS 同源 asset、各自 opacity 校到視覺氣質一致。Per-element opacity 對應 §5.4.1 四態材質。",
      "asset": {
        "$value": "assets/tactile-noise.png",
        "$type": "asset"
      },
      "tile-size": {
        "$value": "256px",
        "$type": "dimension"
      },
      "blend-mode-light": { "$value": "overlay",    "$type": "string" },
      "blend-mode-dark":  { "$value": "soft-light", "$type": "string" },
      "opacity-raised-light":    { "$value": 0.30, "$type": "number" },
      "opacity-raised-dark":     { "$value": 0.30, "$type": "number" },
      "opacity-base-light":      { "$value": 0.55, "$type": "number" },
      "opacity-base-dark":       { "$value": 0.75, "$type": "number" },
      "opacity-secondary-light": { "$value": 0.55, "$type": "number" },
      "opacity-secondary-dark":  { "$value": 0.70, "$type": "number" },
      "opacity-small-light":     { "$value": 0.30, "$type": "number" },
      "opacity-small-dark":      { "$value": 0.20, "$type": "number" }
    }
  }
}
